# Environment Variables for Amis de l'Harmonie de Sucy

# Email Service (Resend API)
# Required for magic link authentication emails
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# Cache Configuration (optional - defaults shown)
# CACHE_TTL_SECONDS=3600                    # Cache time-to-live in seconds (default: 1 hour)
# CACHE_STALE_WHILE_REVALIDATE_SECONDS=86400 # Stale-while-revalidate time in seconds (default: 24 hours)

# Rate Limiting Configuration (optional - defaults shown)
# RATE_LIMIT_AUTH_MAX=5                     # Max magic link requests per window (default: 5)
# RATE_LIMIT_CONTACT_MAX=3                  # Max contact form submissions per window (default: 3)
# RATE_LIMIT_GUESTBOOK_MAX=3                # Max guestbook entries per window (default: 3)
# RATE_LIMIT_UPLOAD_MAX=10                  # Max file uploads per window (default: 10)
