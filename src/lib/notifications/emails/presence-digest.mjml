<mjml lang="fr" dir="ltr">
  <mj-head>
    <mj-title>Essai des rappels de présence – Les Amis de l'Harmonie de Sucy-en-Brie</mj-title>
    <mj-preview>{{preheader}}</mj-preview>
    <mj-attributes>
      <mj-all font-family="'Plus Jakarta Sans', 'Segoe UI', Helvetica, Arial, sans-serif" />
      <mj-text font-size="16px" line-height="1.6" color="#1b2340" />
      <mj-section padding="0" />
      <mj-column padding="0" />
    </mj-attributes>
    <mj-raw>
      <meta name="color-scheme" content="light" /> <meta name="supported-color-schemes"
      content="light" />
    </mj-raw>
    <mj-style>
      :root {
        color-scheme: light;
        supported-color-schemes: light;
      }
      a {
        color: #40518d;
      }
    </mj-style>
  </mj-head>

  <!-- Récapitulatif du mode Essai : même habillage que le rappel, envoyé à l'adresse d'essai seulement -->
  <mj-body width="600px" background-color="#eef2fc">
    <mj-section padding="0">
      <mj-column>
        <mj-spacer height="20px" />
      </mj-column>
    </mj-section>
    <mj-section
      background-color="#ffffff"
      border-radius="14px 14px 0 0"
      padding="22px 24px 16px 24px"
    >
      <mj-group>
        <mj-column width="22%" vertical-align="middle">
          <mj-image
            src="https://amis-harmonie-sucy.fr/images/emails/site/logo.png"
            alt="Les Amis de l'Harmonie"
            width="72px"
            height="72px"
            align="left"
            padding="0"
          />
        </mj-column>
        <mj-column width="78%" vertical-align="middle">
          <mj-text padding="0" font-size="13px" line-height="18px" color="#5d5d5d">
            Les Amis de
          </mj-text>
          <mj-text
            padding="0"
            font-size="20px"
            line-height="26px"
            font-weight="800"
            color="#1b2340"
          >
            l'Harmonie de <span style="white-space: nowrap">Sucy-en-Brie</span>
          </mj-text>
        </mj-column>
      </mj-group>
    </mj-section>
    <mj-section background-color="#ffffff" padding="0">
      <mj-column>
        <mj-divider border-width="4px" border-color="#a2b0d8" padding="0" />
      </mj-column>
    </mj-section>

    <!-- Bandeau « essai » : bien visible, pour qu'on ne le confonde pas avec un vrai rappel -->
    <mj-section background-color="#ffffff" padding="0">
      <mj-column
        padding="24px 24px 8px 24px"
        inner-background-color="#fff3df"
        inner-border-radius="8px"
      >
        <mj-text
          padding="10px 14px"
          font-size="14px"
          line-height="20px"
          font-weight="700"
          color="#7a4300"
        >
          Essai : aucun musicien ni parent n'a reçu ces messages.
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section background-color="#ffffff" padding="0">
      <mj-column padding="12px 24px 4px 24px">
        <mj-text padding="0 0 6px 0" font-size="24px" line-height="30px" font-weight="800">
          Récapitulatif des rappels
        </mj-text>
        <mj-text padding="0" font-size="16px" line-height="24px" color="#2e3550">
          {{intro}}
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Une carte par e-mail qui partirait : HTML injecté, valeurs échappées -->
    <mj-section background-color="#ffffff" padding="0">
      <mj-column padding="16px 24px 4px 24px">
        <mj-text padding="0">{{entries}}</mj-text>
      </mj-column>
    </mj-section>

    <mj-section background-color="#ffffff" padding="0">
      <mj-column padding="12px 24px 8px 24px">
        <mj-button
          href="{{adminUrl}}"
          background-color="#a2b0d8"
          color="#0f0f0f"
          font-size="17px"
          font-weight="700"
          line-height="22px"
          border-radius="10px"
          inner-padding="14px 28px"
          padding="0"
          align="center"
        >
          Ouvrir la page des e-mails automatiques
        </mj-button>
      </mj-column>
    </mj-section>

    <mj-section background-color="#ffffff" border-radius="0 0 14px 14px" padding="0">
      <mj-column padding="20px 24px 26px 24px">
        <mj-text padding="0" align="center" font-size="13px" line-height="20px" color="#5d5d5d">
          Vous recevez ce récapitulatif parce que les rappels sont en mode Essai. Rien ne part vers
          les musiciens ni les parents tant que vous n'avez pas activé les rappels.
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section padding="0">
      <mj-column padding="18px 24px 28px 24px">
        <mj-text padding="0" align="center" font-size="12px" line-height="18px" color="#5d5d5d">
          Les Amis de l'Harmonie de Sucy-en-Brie<br />
          <a href="https://amis-harmonie-sucy.fr" style="color: #40518d; text-decoration: underline"
            >amis-harmonie-sucy.fr</a
          >
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
